{
  "name": "Super API UCOS",
  "short_name": "UCOS",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "browser"],
  "orientation": "any",
  "background_color": "#07111d",
  "theme_color": "#0b1020",
  "description": "Browser-native Universal Capability OS with local apps, capability routing, virtual files, workflows, peer nodes, developer diagnostics and offline PWA support.",
  "icons": [{"src":"./icon.svg","sizes":"any","type":"image/svg+xml","purpose":"any maskable"}],
  "launch_handler": {"client_mode":"navigate-existing"},
  "shortcuts": [
    {"name":"UCOS Home","short_name":"Home","url":"./"},
    {"name":"Files","short_name":"Files","url":"./?ucos_app=files"},
    {"name":"Devices","short_name":"Devices","url":"./?ucos_app=devices"},
    {"name":"Camera","short_name":"Camera","url":"./?ucos_app=camera"},
    {"name":"Capability Center","short_name":"Capabilities","url":"./?ucos_app=capabilities"},
    {"name":"Developer Lab","short_name":"Developer","url":"./?ucos_app=devlab"}
  ],
  "share_target": {"action":"./","method":"GET","enctype":"application/x-www-form-urlencoded","params":{"title":"share_title","text":"share_text","url":"share_url"}},
  "protocol_handlers": [{"protocol":"web+superapi","url":"./?protocol=%s"}],
  "file_handlers": [{"action":"./","accept":{"text/plain":[".txt"],"application/json":[".json"]}}]
}
